# Export these values in your shell; the app does not automatically read .env.
# No inference keys or model download are used.
MVP_MODE=saved_example
# For live discovery choose MVP_MODE=live and set your developer contact email.
# NCBI_EMAIL=researcher@example.org
# NCBI_API_KEY=  # optional; never commit a real value
# MVP_DATA_DIR=/absolute/private/path/to/lit-review-mvp
MVP_HTTP_TIMEOUT_SECONDS=12
