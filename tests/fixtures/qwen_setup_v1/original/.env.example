# Optional passage generation (ask.py).
AGNES_API_KEY=
AGNES_BASE_URL=https://apihub.agnes-ai.com/v1
AGNES_MODEL=agnes-2.0-flash

# Optional cloud source retrieval (review.py retrieve-qwen).
# retrieve-qwen reads this key from the environment or the local .env file.
# Optional URL overrides must be exported in the shell.
DEEPINFRA_API_KEY=
QWEN_EMBEDDING_URL=https://api.deepinfra.com/v1/inference/Qwen/Qwen3-Embedding-4B
QWEN_RERANKER_URL=https://api.deepinfra.com/v1/inference/Qwen/Qwen3-Reranker-4B
