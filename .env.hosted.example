# Runtime settings only. Do not pass secrets as Docker build arguments.
# Copy into the hosting platform's private environment settings after approval.
# The placeholders below deliberately fail validation until replaced.
MVP_DEPLOYMENT_MODE=hosted
MVP_HOSTED_INGRESS=render
MVP_PUBLIC_ORIGIN=https://REPLACE_ME.onrender.com
MVP_API_HOST=127.0.0.1:8765
MVP_API_ORIGIN=http://127.0.0.1:8765
MVP_PERSISTENT_ROOT=/var/data
MVP_WEB_DATA_DIR=/var/data/litrev
MVP_HOSTED_INVITE_SHA256=REPLACE_WITH_SHA256_OF_A_RANDOM_INVITATION_CODE
PORT=10000
NEXT_TELEMETRY_DISABLED=1

# The initial hosted release deliberately refuses enabled generation/new maps.
MVP_PROPOSALS_ENABLED=0
MVP_SEARCH_PLANNER_ENABLED=0
MVP_MAP_ENABLED=0

# Optional operator contact; blank keeps live PubMed unavailable.
# Configure an actual contact privately only when authorizing live discovery.
NCBI_EMAIL=
NCBI_API_KEY=
MVP_HTTP_TIMEOUT_SECONDS=12
