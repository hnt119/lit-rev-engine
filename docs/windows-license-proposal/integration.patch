+def copy_proposed_microsoft_component_terms(resources):
+    """INACTIVE patch: bind the complete, owner-reviewed future display text.
+
+    Applying this patch is not approval of the draft or SDK redistribution.
+    The current owner-review text must be approved before production use.
+    """
+    source=ROOT/'docs/windows-license-proposal/MICROSOFT_COMPONENT_TERMS.txt'
+    sdk=resources/'WINDOWS_DEPENDENCY_NOTICES/microsoft-sdk-10.0.28000.2270'
+    python=resources/'python/LICENSE.txt'
+    inputs={
+        'proposed_component_terms':source,
+        'complete_sdk_license_readable':sdk/'LICENSE.rendered.txt',
+        'complete_sdk_license_authoritative':sdk/'LICENSE.rtf',
+        'complete_python_license':python,
+    }
+    if any(path.is_symlink() or not path.is_file() for path in inputs.values()):
+        raise ValueError('Require complete retained Microsoft SDK and Python terms before packaging the proposal.')
+    sections=[('Microsoft-component protective terms — owner-reviewed text',source),
+              ('Complete retained Windows SDK license — readable conversion; original LICENSE.rtf retained alongside',sdk/'LICENSE.rendered.txt'),
+              ('Complete retained Python license, including Additional Conditions for this Windows binary build',python)]
+    combined=b'\xef\xbb\xbf'
+    for title,path in sections:
+        combined+=('\n\n===== '+title+' =====\n\n').encode('utf-8')+path.read_bytes()
+    destination=resources/'MICROSOFT_COMPONENT_TERMS_WITH_LICENSES.txt'
+    if destination.exists() or destination.is_symlink():raise ValueError('Do not overwrite an existing Microsoft-component display file.')
+    destination.write_bytes(combined)
+    return {'schema':'litrev.windows.microsoft-component-terms-proposal.v1',
+            'status':'OWNER_REVIEW_REQUIRED; applying this inactive patch does not establish permission',
+            'displayed_and_retained_path':destination.relative_to(resources.parent).as_posix(),
+            'displayed_and_retained_sha256':digest(combined),
+            'inputs':{name:{'bytes':path.stat().st_size,'sha256':digest(path.read_bytes())} for name,path in inputs.items()},
+            'scope':'Microsoft components only; engine MIT, Python, FFmpeg and other independent terms unchanged',
+            'silent_installation':'rejected; no unattended acceptance flag',
+            'windows_interaction':'NOT_RUN'}


